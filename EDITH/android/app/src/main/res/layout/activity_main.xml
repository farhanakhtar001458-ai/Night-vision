<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#05080F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#38E0C8"
            android:textSize="34sp"
            android:letterSpacing="0.25"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textColor="#7E93AD"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTalk"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="22dp"
            android:background="#38E0C8"
            android:text="@string/talk"
            android:textColor="#04121A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status"
            android:textColor="#38E0C8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="60dp"
            android:text="@string/reply"
            android:textColor="#D6E6F5"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAlways"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/always"
            android:textColor="#E8F4FF"
            android:background="#132033" />

        <Button
            android:id="@+id/btnWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#132033"
            android:text="Wake word: ON"
            android:textColor="#E8F4FF" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#132033"
            android:text="Voice: English"
            android:textColor="#E8F4FF" />

        <Button
            android:id="@+id/btnNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/notif_access"
            android:textColor="#E8F4FF"
            android:background="#132033" />

        <Button
            android:id="@+id/btnAnnounce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/announce"
            android:textColor="#E8F4FF"
            android:background="#132033" />

        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/help"
            android:textColor="#E8F4FF"
            android:background="#132033" />

        <TextView
            android:id="@+id/txtHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#9FB4CC"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Made by Farhan"
            android:textColor="#3E5570"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
