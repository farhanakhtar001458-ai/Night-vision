<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Credentials live in the Android Keystore and must never be backed up off-device. -->
        <exclude domain="sharedpref" path="droidlinkx.secure.v1.xml" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="droidlinkx.secure.v1.xml" />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
