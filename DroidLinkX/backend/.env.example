# ---- DroidLink X backend ----
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/droidlinkx

# Redis (optional in development: an in-process cache adapter is used when unset)
REDIS_URL=
REDIS_PREFIX=droidlinkx:

# Secrets - generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-48-byte-random-secret
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
DEVICE_TOKEN_TTL=2592000

# Time-limited TURN credentials (coturn static-auth-secret)
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=replace-me-turn-shared-secret
TURN_TTL=3600

# File relay storage
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=2147483648
DOWNLOAD_URL_TTL=300
