# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dedicated signalling relay. In production: wss://signal.example.com/ws
# In development the Vite dev server proxies /ws to http://127.0.0.1:8090.
VITE_SIGNALING_URL=

# Public STUN/TURN information shown in the UI. TURN credentials are always minted per connection by
# the authorize-connection Edge Function; never put a TURN password here.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp
