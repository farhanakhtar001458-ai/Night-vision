# ----- Supabase (required) -------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-side-only
# Shared with the Edge Functions: signs/validates device tokens (HS256).
DEVICE_JWT_SECRET=change-me-32-bytes-minimum
# Owner tokens: either the project JWT secret or JWKS verification (recommended).
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# ----- Server --------------------------------------------------------------
PORT=8090
HEARTBEAT_MS=30000
MAX_CONNECTIONS=2000
CORS_ORIGINS=https://cloud.example.com

# ----- TURN (minted per connection by authorize-connection) ----------------
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SECRET=change-me
