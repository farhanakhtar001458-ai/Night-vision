# Copy to infrastructure/docker/.env and fill in every required value.
POSTGRES_DB=droidlinkx
POSTGRES_USER=droidlinkx
POSTGRES_PASSWORD=change-me-strong-db-password
REDIS_PASSWORD=change-me-strong-redis-password

PUBLIC_BASE_URL=https://cloud.example.com
CORS_ORIGINS=https://cloud.example.com

# openssl rand -base64 48
JWT_SECRET=replace-with-48-byte-base64url-secret

TURN_REALM=droidlinkx
TURN_SECRET=replace-with-turn-shared-secret
TURN_EXTERNAL_IP=203.0.113.10
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
MAX_UPLOAD_BYTES=2147483648
LOG_LEVEL=info
